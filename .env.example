# ============================================================
# .env.example — copy this file to .env and fill in your values.
# NEVER commit .env to Git. It is already listed in .gitignore.
# NEVER put a real API key in this file.
# ============================================================

# --- Google Gemini API (required for AI explanations) ---
#
# 1. Obtain a free API key at https://aistudio.google.com/apikey
# 2. Log in with a Google account. No billing is required to generate
#    a key, but quota limits and terms vary by account and may change.
#    Review your current quota and billing status at:
#    https://aistudio.google.com — "Get API Key" → "View quota"
# 3. Copy the key value here (replace YOUR_KEY_HERE).
# 4. Keep this file private. Do not share, log, or commit it.
GEMINI_API_KEY=YOUR_KEY_HERE

# --- Model selection (optional) ---
#
# The service defaults to gemini-2.0-flash-lite if this variable is absent.
# You may override it with any model name supported by your API key.
# To see available models, visit:
#   https://aistudio.google.com — "Run in Google AI Studio" → model dropdown
# or call the REST endpoint:
#   curl https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY_HERE
#
# Stable aliases (as of late 2025; verify availability for your account):
#   gemini-2.0-flash-lite   — fast, cost-efficient (default)
#   gemini-2.0-flash        — slightly more capable
#   gemini-1.5-flash-latest — older generation fallback
#
# If the model is not found, the endpoint returns a clear NOT_CONFIGURED error.
# GEMINI_MODEL=gemini-2.0-flash-lite
